# ==============================================================================
# UNITED FOOD PALACE - SUPABASE ENVIRONMENT CONFIGURATION
# ==============================================================================
# Obtain these from your Supabase Project Dashboard -> Project Settings -> API
# https://supabase.com/dashboard/project/_/settings/api

# 1. Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Public Anonymous API Key (safe for browser & client calls)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Service Role Secret Key (Optional - for administrative tasks and automated bucket creation)
SUPABASE_SERVICE_ROLE_KEY=
